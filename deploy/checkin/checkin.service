[Unit]
Description=Agile in Africa attendance check-in
After=network.target

[Service]
Type=simple
User=checkin
Group=checkin
WorkingDirectory=/opt/checkin
Environment=NODE_ENV=production
EnvironmentFile=/etc/checkin/checkin.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/checkin/data

[Install]
WantedBy=multi-user.target